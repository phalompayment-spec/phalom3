{
  "name": "phalom",
  "private": true,
  "version": "1.0.0",
  "description": "Phalom: merchant app for small Lao vendors to accept tourist QR payments (demo payments). Cloudflare Workers + Supabase.",
  "scripts": {
    "dev": "wrangler dev -c wrangler.local.toml",
    "local-db": "node scripts/local-supabase.mjs",
    "deploy": "wrangler deploy",
    "db:push": "node scripts/db-push.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251001.0",
    "pg": "8.13.1",
    "typescript": "5.6.3",
    "wrangler": "4.42.0"
  }
}
